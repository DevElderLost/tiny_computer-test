#!/bin/bash
# Memasang "snap palsu" di kontainer Ubuntu/Debian arm64 milik Tiny Computer: systemd palsu, squashfs palsu (ekstrak,
# bukan mount), tiny-snapd (pengganti snapd + perintah `snap`) lalu Ubuntu App Center (snap-store).
# Dijalankan di TERMINAL kontainer sebagai pengguna `tiny` (sudo tanpa kata sandi).
# Penanda selesai: ~/.local/share/tiny/snap/setup.done ; penanda gagal: setup.failed (isinya alasan).
# TINY_SNAP_SKIP_APPCENTER=1 : hanya pasang infrastruktur, tanpa mengunduh App Center (~500 MB dengan gnome-42-2204).
set -u
export LANG=C.UTF-8
export DEBIAN_FRONTEND=noninteractive
DIR="$HOME/.local/share/tiny/snap"
LIB=/usr/local/lib/tiny-snap
mkdir -p "$DIR"
rm -f "$DIR/setup.done" "$DIR/setup.failed"

step() { echo; echo "== [$1/6] $2"; }
fail() { echo; echo "== GAGAL: $*"; echo "$*" > "$DIR/setup.failed"; exit 1; }

echo "=== Pasang snap palsu + Ubuntu App Center ==="

step 1 "Memeriksa sistem"
[ -r /etc/os-release ] && . /etc/os-release
echo "Distro: ${PRETTY_NAME:-tidak diketahui}"
ARCH="$(dpkg --print-architecture 2>/dev/null)"
[ "$ARCH" = "arm64" ] || fail "arsitektur $ARCH tidak didukung; snap di sini hanya untuk arm64 (aarch64)"
for f in tiny-snapd.py tiny-systemctl tiny-mount; do
	[ -f "$DIR/$f" ] || fail "$f tidak ada di $DIR (buka ulang aplikasi lalu coba lagi)"
done
sudo -n true 2>/dev/null || fail "sudo tanpa kata sandi tidak tersedia"

step 2 "Memasang paket pendukung"
sudo apt-get update || fail "apt update gagal; periksa koneksi internet"
sudo apt-get install -y --no-install-recommends squashfs-tools python3 python3-yaml ca-certificates xdg-utils \
	|| fail "apt install squashfs-tools python3 python3-yaml gagal"
sudo apt-get install -y --no-install-recommends libgl1 libegl1 libgles2 2>/dev/null \
	|| echo "Peringatan: libgl1/libegl1/libgles2 tidak terpasang; aplikasi snap berbasis Flutter bisa gagal membuka jendela."
command -v unsquashfs >/dev/null 2>&1 || fail "unsquashfs tidak ada setelah pemasangan"

step 3 "Systemd palsu"
sudo mkdir -p "$LIB" /run/systemd/system /var/lib/tiny-fake-systemd/active /var/lib/tiny-fake-systemd/enabled /var/lib/tiny-fake-systemd/masked
sudo chmod -R 1777 /var/lib/tiny-fake-systemd
# systemd asli (bila ada) dialihkan lewat dpkg-divert supaya pembaruan paket tidak mengembalikan systemctl asli
if [ -e /usr/bin/systemctl ] && ! dpkg-divert --list 2>/dev/null | grep -q 'systemctl.real'; then
	if dpkg -S /usr/bin/systemctl >/dev/null 2>&1; then
		sudo dpkg-divert --local --rename --divert /usr/bin/systemctl.real --add /usr/bin/systemctl >/dev/null 2>&1 \
			|| echo "Peringatan: dpkg-divert systemctl gagal; systemctl palsu tetap ditimpa langsung."
	fi
fi
sudo install -m 0755 "$DIR/tiny-systemctl" /usr/bin/systemctl || fail "tidak bisa memasang systemctl palsu"
# layanan tidak pernah dijalankan oleh apt/dpkg di proot (invoke-rc.d membaca berkas ini)
printf '#!/bin/sh\nexit 101\n' | sudo tee /usr/sbin/policy-rc.d >/dev/null && sudo chmod 0755 /usr/sbin/policy-rc.d
systemctl is-system-running >/dev/null 2>&1 && echo "systemctl palsu aktif."

step 4 "Squashfs palsu (mount = ekstrak)"
sudo install -m 0755 "$DIR/tiny-mount" "$LIB/tiny-mount" || fail "tidak bisa memasang tiny-mount"
for n in mount umount mountpoint; do sudo ln -sf "$LIB/tiny-mount" "/usr/local/bin/$n"; done
echo "mount -t squashfs X DIR kini mengekstrak X ke DIR."

step 5 "Memasang tiny-snapd dan perintah snap"
sudo install -m 0755 "$DIR/tiny-snapd.py" "$LIB/tiny-snapd.py" || fail "tidak bisa memasang tiny-snapd"
sudo ln -sf "$LIB/tiny-snapd.py" /usr/local/bin/snap
UG="$(id -u):$(id -g)"
sudo mkdir -p /snap/bin /var/snap /var/lib/snapd/snaps /var/lib/snapd/desktop/applications
sudo chown -R "$UG" /snap /var/snap /var/lib/snapd 2>/dev/null
mkdir -p "$HOME/snap" "$HOME/.local/share/applications"
# /snap/bin masuk PATH untuk shell login dan sesi desktop
printf 'case ":$PATH:" in *:/snap/bin:*) ;; *) export PATH="$PATH:/snap/bin" ;; esac\n' | sudo tee /etc/profile.d/tiny-snap.sh >/dev/null
export PATH="$PATH:/snap/bin"
snap version >/dev/null 2>&1 || fail "perintah snap tidak bisa dijalankan (python3-yaml?)"
snap version | head -n 2

if [ "${TINY_SNAP_SKIP_APPCENTER:-0}" = 1 ]; then
	echo; echo "(TINY_SNAP_SKIP_APPCENTER=1: App Center dilewati)"
else
	step 6 "Memasang Ubuntu App Center (snap-store)"
	echo "Mengunduh snap-store dan content snap-nya dari Snap Store; ini besar dan bisa lama."
	snap install snap-store || fail "snap install snap-store gagal (lihat pesan di atas)"
fi

: > "$DIR/setup.done"
echo
echo "== SELESAI: snap palsu terpasang."
echo "Buka 'App Center' dari menu aplikasi, atau jalankan: snap run snap-store"
echo "Pasang snap lain dengan: snap install <nama>"
