+#ifndef XWAYLAND_DRI3_NODRM_H
+#define XWAYLAND_DRI3_NODRM_H
+
+#include <xwayland-config.h>
+
+#include <wayland-client.h>
+
+#include "pixmapstr.h"
+#include "xwayland-types.h"
+
+/*
+ * DRI3 without a DRM device.
+ *
+ * Stock Xwayland only offers DRI3 through glamor/GBM, which needs a DRM
+ * render node. Environments without /dev/dri (proot on Android, containers)
+ * therefore get no DRI3 at all and clients fall back to MIT-SHM / DRI2.
+ *
+ * This backend registers DRI3 1.2 on top of the plain wl_shm code path:
+ *  - DRI3Open is refused (there is no DRM fd to hand out); clients that
+ *    skip it (Mesa Vulkan WSI) keep working.
+ *  - Only DRM_FORMAT_MOD_LINEAR is advertised, so every client buffer is
+ *    CPU-readable.
+ *  - PixmapFromBuffers wraps the client's dma-buf: the fd is mmap()ed and
+ *    becomes the pixmap storage, so Present can always copy it.
+ *  - When the compositor advertises linux-dmabuf for that format with
+ *    LINEAR, a wl_buffer is also created from the same fd so Present can
+ *    flip it with zero copies. If that fails the copy path is used.
+ */
+
+#ifdef DRI3
+Bool xwl_nodrm_dri3_init(struct xwl_screen *xwl_screen);
+void xwl_nodrm_dri3_registry_global(struct xwl_screen *xwl_screen,
+                                    const char *interface,
+                                    uint32_t id, uint32_t version);
+Bool xwl_nodrm_dri3_is_pixmap(PixmapPtr pixmap);
+struct wl_buffer *xwl_nodrm_dri3_pixmap_get_wl_buffer(PixmapPtr pixmap);
+#else
+static inline Bool xwl_nodrm_dri3_init(struct xwl_screen *s) { return FALSE; }
+static inline void xwl_nodrm_dri3_registry_global(struct xwl_screen *s,
+                                                  const char *i,
+                                                  uint32_t id, uint32_t v) { }
+static inline Bool xwl_nodrm_dri3_is_pixmap(PixmapPtr p) { return FALSE; }
+static inline struct wl_buffer *
+xwl_nodrm_dri3_pixmap_get_wl_buffer(PixmapPtr p) { return NULL; }
+#endif /* DRI3 */
+
+#endif /* XWAYLAND_DRI3_NODRM_H */
